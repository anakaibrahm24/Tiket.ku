                                    {
                                      "type": "frame",
                                      "id": "BqYD1",
                                      "name": "div",
                                      "context": "div",
                                      "width": "fill_container",
                                      "layout": "vertical",
                                      "gap": 32,
                                      "justifyContent": "space_between",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "q77FKe",
                                          "name": "\"MindCloud has managed 100% of the integ",
                                          "context": "blockquote",
                                          "fill": "#27272a",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 192,
                                          "content": "\"MindCloud has managed 100% of the integration development for over 4 years and provided the integration platform itself. The platform on it's own was a better value than Celigo and Jitterbit (both of which we used previously) and has saved us from having to dedicate FTEs to develop and maintain the API integrations between systems.\"",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "500",
                                          "letterSpacing": -0.16
                                        },
