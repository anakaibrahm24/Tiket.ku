                                          "id": "mFrmu",
                                          "name": "\"What I liked most about MindCloud was i",
                                          "context": "blockquote",
                                          "fill": "#27272a",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 144,
                                          "content": "\"What I liked most about MindCloud was its flexibility and the quality of its customer support. The platform gave us the power to create a customized integration between HubSpot and NetSuite that perfectly matched our unique business needs.\"",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "500",
                                          "letterSpacing": -0.16
